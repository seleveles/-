import random

def generate_matrix(rows, cols, low=-50, high=50):
    """Генерирует матрицу rows x cols со случайными числами."""
    matrix = []
    for i in range(rows):
        row = []
        for j in range(cols):
            row.append(random.randint(low, high))
        matrix.append(row)
    return matrix

def add_matrices(m1, m2):
    """Складывает две матрицы одинаковой размерности."""
    if len(m1) != len(m2) or len(m1[0]) != len(m2[0]):
        raise ValueError("Матрицы должны быть одинаковой размерности")
    
    rows = len(m1)
    cols = len(m1[0])
    result = []
    
    for i in range(rows):
        new_row = []
        for j in range(cols):
            new_row.append(m1[i][j] + m2[i][j])
        result.append(new_row)
    
    return result

def print_matrix(matrix, name="Матрица"):
    print(f"{name}:")
    for row in matrix:
        print(row)
    print()

# --- Пример использования: матрицы 10x10 ---
rows, cols = 10, 10
matrix_1 = generate_matrix(rows, cols)
matrix_2 = generate_matrix(rows, cols)
matrix_sum = add_matrices(matrix_1, matrix_2)

print_matrix(matrix_1, "Матрица 1 (10x10)")
print_matrix(matrix_2, "Матрица 2 (10x10)")
print_matrix(matrix_sum, "Сумма матриц (10x10)")

# --- Пример для неквадратной матрицы: 4x3 ---
rows2, cols2 = 4, 3
matrix_3 = generate_matrix(rows2, cols2)
matrix_4 = generate_matrix(rows2, cols2)
matrix_sum2 = add_matrices(matrix_3, matrix_4)

print_matrix(matrix_3, "Матрица 3 (4x3)")
print_matrix(matrix_4, "Матрица 4 (4x3)")
print_matrix(matrix_sum2, "Сумма матриц (4x3)")
