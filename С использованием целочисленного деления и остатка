def calculate_product_of_digits(number):
 # Проверяем, что число трёхзначное
 if not (100 <= number <= 999):
 raise ValueError("Число должно быть трёхзначным (от 100 до 999)")
 
 # Получаем цифры числа
 hundreds = number // 100 # сотни
 tens = (number // 10)% 10 # десятки
 ones = number% 10 # единицы
 
 # Вычисляем произведение цифр
 product = hundreds * tens * ones
 
 return product

# Пример использования
number = 462
result = calculate_product_of_digits(number)
print(result) # Выведет: 48 (так как 4 * 6 * 2 = 48)
