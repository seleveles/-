def rotate_array(arr):
    return arr[-1:] + arr[:-1]  # Последний элемент + все элементы, кроме последнего

n = int(input()) # Чтение и вывод (N нам фактически не нужно для логики, но считываем по условию)
arr = list(map(int, input().split()))

rotated = arr[-1:] + arr[:-1] # Создаём новый массив по формуле сдвига

print(*rotated) # Выводим результат
