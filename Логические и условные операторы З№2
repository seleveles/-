word = input("Введите слово из маленьких латинских букв: ") # Получаем слово от пользователя
vowels = {'a', 'e', 'i', 'o', 'u'} # Определяем множество гласных букв
consonant_count = 0 # Инициализируем счётчики
vowel_count = 0
vowel_counts = {vowel: 0 for vowel in vowels} # Словарь для подсчёта каждой гласной буквы
for letter in word: # Перебираем каждую букву в слове
    if letter in vowels:
        vowel_count += 1
        vowel_counts[letter] += 1
    else:
        consonant_count += 1
    print(f"Согласных букв: {consonant_count}") # Выводим общее количество согласных и гласных
    print(f"Гласных букв: {vowel_count}")
    print("Количество каждой гласной буквы:") # Проверяем наличие каждой гласной и выводим результат
for vowel in sorted(vowels):
    count = vowel_counts[vowel]
    if count == 0:
        print(f"{vowel}: False")
    else:
        print(f"{vowel}: {count}")
