def factorial(n: int) -> int: # """Вычисляет факториал натурального числа n."""
       if n < 1: 
        raise ValueError("Число должно быть натуральным (>= 1).")
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

num = int(input("Введите натуральное число: ")) # Получаем число от пользователя

fact_num = factorial(num) # Считаем факториал этого числа
print(f"Факториал числа {num} равен {fact_num}")

factorials_list = [] # Создаём список факториалов от fact_num до 1 (в убывающем порядке)
for i in range(fact_num, 0, -1):
    factorials_list.append(factorial(i))

print(factorials_list)
